{
  "rules": {
    ".read": false,
    ".write": false,
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'email'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 254"
        },
        "phone": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 30)"
        },
        "roleRequested": {
          ".validate": "!newData.exists() || (newData.isString() && (newData.val() === 'Farmer' || newData.val() === 'Cold Storage' || newData.val() === 'Porter' || newData.val() === 'Buyer'))"
        },
        "storageName": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 120)"
        },
        "partnerName": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 100)"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "accessRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !data.exists()",
        ".validate": "newData.hasChildren(['requestedRole', 'status', 'createdAt']) && newData.child('status').val() === 'PENDING'",
        "requestedRole": {
          ".validate": "newData.isString() && (newData.val() === 'Farmer' || newData.val() === 'Cold Storage' || newData.val() === 'Porter' || newData.val() === 'Buyer')"
        },
        "requestedStorageName": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 120)"
        },
        "status": {
          ".validate": "newData.val() === 'PENDING'"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "userAccess": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "deviceAccess": {
      ".read": false,
      ".write": false
    },
    "facilities": {
      "$facilityId": {
        "latest": {
          ".read": "auth != null && root.child('userAccess').child(auth.uid).child('active').val() === true && (root.child('userAccess').child(auth.uid).child('role').val() === 'Admin' || (root.child('userAccess').child(auth.uid).child('role').val() === 'Cold Storage' && root.child('userAccess').child(auth.uid).child('facilityId').val() === $facilityId) || (root.child('userAccess').child(auth.uid).child('role').val() === 'Farmer' && root.child('userAccess').child(auth.uid).child('facilityIds').child($facilityId).val() === true))",
          ".write": "auth != null && auth.uid === 'AcyUBsOW9ePKOo87aUUxf0RYd9c2' && $facilityId === 'COLD_BOX_01' && newData.exists()",
          ".validate": "newData.hasChildren(['facility_id', 'temperature', 'humidity', 'methane_ppm', 'raw_adc', 'sensor_voltage', 'device_timestamp_ms', 'received_at'])",
          "facility_id": {
            ".validate": "newData.isString() && newData.val() === $facilityId"
          },
          "temperature": {
            ".validate": "newData.isNumber() && newData.val() >= -40 && newData.val() <= 100"
          },
          "humidity": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "methane_ppm": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
          },
          "raw_adc": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4095"
          },
          "sensor_voltage": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
          },
          "device_timestamp_ms": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4294967295"
          },
          "received_at": {
            ".validate": "newData.isNumber() && newData.val() > 0"
          },
          "$other": {
            ".validate": false
          }
        },
        "history": {
          ".read": "auth != null && root.child('userAccess').child(auth.uid).child('active').val() === true && (root.child('userAccess').child(auth.uid).child('role').val() === 'Admin' || (root.child('userAccess').child(auth.uid).child('role').val() === 'Cold Storage' && root.child('userAccess').child(auth.uid).child('facilityId').val() === $facilityId) || (root.child('userAccess').child(auth.uid).child('role').val() === 'Farmer' && root.child('userAccess').child(auth.uid).child('facilityIds').child($facilityId).val() === true))",
          ".indexOn": [
            "received_at"
          ],
          "$recordId": {
            ".write": "auth != null && auth.uid === 'AcyUBsOW9ePKOo87aUUxf0RYd9c2' && $facilityId === 'COLD_BOX_01' && newData.exists() && $recordId.matches(/^slot_([0-9]{1,4}|100[0-6][0-9]|1007[0-9])$/)",
            ".validate": "newData.hasChildren(['facility_id', 'temperature', 'humidity', 'methane_ppm', 'raw_adc', 'sensor_voltage', 'device_timestamp_ms', 'received_at'])",
            "facility_id": {
              ".validate": "newData.isString() && newData.val() === $facilityId"
            },
            "temperature": {
              ".validate": "newData.isNumber() && newData.val() >= -40 && newData.val() <= 100"
            },
            "humidity": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "methane_ppm": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
            },
            "raw_adc": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4095"
            },
            "sensor_voltage": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
            },
            "device_timestamp_ms": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4294967295"
            },
            "received_at": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}
